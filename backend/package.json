{
  "name": "star-shop-api",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "test": "tsx --test test/*.test.ts",
    "admin:create": "tsx --env-file-if-exists=.env src/create-admin.ts"
  },
  "dependencies": {
    "express": "^5.1.0",
    "better-sqlite3": "^11.10.0",
    "multer": "^2.0.2",
    "zod": "^4.3.6",
    "express-rate-limit": "^8.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.10.1",
    "typescript": "~5.9.3",
    "tsx": "^4.20.0"
  }
}
